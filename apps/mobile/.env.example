# Copy to apps/mobile/.env. Values are public client configuration (inlined at build time);
# never put OpenAI keys, service-account JSON or other secrets here.

# COVERT API base URL (Cloud Run service URL, or your machine's LAN address in development).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Firebase web app config: Firebase console → Project settings → Your apps → Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Optional: use the Firebase Auth emulator (host:port) during development.
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
