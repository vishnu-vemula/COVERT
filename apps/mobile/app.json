{
  "expo": {
    "name": "COVERT",
    "slug": "covert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "covert",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F5F0",
    "ios": {
      "bundleIdentifier": "com.example.covert",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.example.covert",
      "adaptiveIcon": {
        "backgroundColor": "#111311",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "COVERT uses the camera to photograph documents you choose to convert.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "COVERT opens the photos you choose so they can be converted into tables.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
