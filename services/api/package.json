{
  "name": "@covert/api",
  "version": "1.0.0",
  "private": true,
  "description": "COVERT API — authenticated OCR and structuring service for Google Cloud Run.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@covert/shared": "*",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@google-cloud/vision": "^6.1.1",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "openai": "^7.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "globals": "^16.5.0"
  }
}
