# Copy to services/api/.env for local development. Never commit real values.

# Firebase / Google Cloud project that owns Auth and Firestore.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Application Default Credentials for Firestore and Cloud Vision.
# Locally: path to a service-account key with Firestore + Vision access.
# On Cloud Run: leave unset; the service account attached to the service is used.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# OpenAI — server-side only.
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=120000

# Server
PORT=8080
LOG_LEVEL=info
NODE_ENV=development

# Abuse protection
CONVERSIONS_PER_HOUR=30
REQUESTS_PER_MINUTE=120

# Browser origins allowed to call the API (only needed when running the mobile app on web).
# CORS_ORIGINS=http://localhost:8081

# Optional: use the Firebase emulators instead of the real services.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
